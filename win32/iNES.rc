/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_INES                ICON                    "iNES.ico"
IDI_SMALL               ICON                    "small.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_INES MENU 
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "载入ROM(&O)...\tCtrl+O",        IDM_OPEN
        MENUITEM "卸载ROM(&U)\tCtrl+U",           IDM_CLOSE
        MENUITEM SEPARATOR
        MENUITEM "联网对战",                        IDM_NET_PLAY
        MENUITEM SEPARATOR
        MENUITEM "最近文件",                        32990, INACTIVE
        MENUITEM SEPARATOR
        MENUITEM "退出(&X)\tAtl+Q",               IDM_EXIT
    END
    POPUP "控制(&C)"
    BEGIN
        MENUITEM "重新上电(&R)\tCtrl+F1",           IDM_HARDRESET
        MENUITEM "软件复位(&S)\tF1",                IDM_SOFTRESET
        MENUITEM SEPARATOR
        MENUITEM "暂停(&P)\tP",                   IDM_PAUSE
        MENUITEM "单帧执行(&T)\tSpace",             IDM_FRAME_STEP
        MENUITEM SEPARATOR
        MENUITEM "全屏(&F)\tF12",                 IDM_FULL_SCREEN
        POPUP "缩放(&X)"
        BEGIN
            MENUITEM "x 1\tF5",                     IDM_ZOOM_X1
            MENUITEM "x 2\tF6",                     IDM_ZOOM_X2
            MENUITEM "x 3\tF7",                     IDM_ZOOM_X3
            MENUITEM "x 4\tF8",                     IDM_ZOOM_X4
        END
        POPUP "比例(&C)"
        BEGIN
            MENUITEM "原始比例",                        IDM_SCALE_ORIG
            MENUITEM "4：3",                         IDM_SCALE_4x3
            MENUITEM "16：9",                        IDM_SCALE_16x9
        END
        MENUITEM SEPARATOR
        MENUITEM "静音(&M)\tF9",                  IDM_MUTE
        POPUP "音量(&V)"
        BEGIN
            MENUITEM "100%",                        IDM_VOLUMN_100
            MENUITEM "80%",                         IDM_VOLUMN_80
            MENUITEM "60%",                         IDM_VOLUMN_60
            MENUITEM "40%",                         IDM_VOLUMN_40
            MENUITEM "20%",                         IDM_VOLUMN_20
            MENUITEM "0%",                          IDM_VOLUMN_0
        END
        MENUITEM SEPARATOR
        POPUP "即时存档(&V)"
        BEGIN
            MENUITEM "存档 0\tCtrl+0",                IDM_SAVE_STATE_0
            MENUITEM "存档 1\tCtrl+1",                IDM_SAVE_STATE_1
            MENUITEM "存档 2\tCtrl+2",                IDM_SAVE_STATE_2
            MENUITEM "存档 3\tCtrl+3",                IDM_SAVE_STATE_3
            MENUITEM "存档 4\tCtrl+4",                IDM_SAVE_STATE_4
            MENUITEM "存档 5\tCtrl+5",                IDM_SAVE_STATE_5
            MENUITEM "存档 6\tCtrl+6",                IDM_SAVE_STATE_6
            MENUITEM "存档 7\tCtrl+7",                IDM_SAVE_STATE_7
            MENUITEM "存档 8\tCtrl+8",                IDM_SAVE_STATE_8
            MENUITEM "存档 9\tCtrl+9",                IDM_SAVE_STATE_9
        END
        POPUP "载入存档(&L)"
        BEGIN
            MENUITEM "存档 0\tCtrl+Shift+0",          IDM_LOAD_STATE_0
            MENUITEM "存档 1\tCtrl+Shift+1",          IDM_LOAD_STATE_1
            MENUITEM "存档 2\tCtrl+Shift+2",          IDM_LOAD_STATE_2
            MENUITEM "存档 3\tCtrl+Shift+3",          IDM_LOAD_STATE_3
            MENUITEM "存档 4\tCtrl+Shift+4",          IDM_LOAD_STATE_4
            MENUITEM "存档 5\tCtrl+Shift+5",          IDM_LOAD_STATE_5
            MENUITEM "存档 6\tCtrl+Shift+6",          IDM_LOAD_STATE_6
            MENUITEM "存档 7\tCtrl+Shift+7",          IDM_LOAD_STATE_7
            MENUITEM "存档 8\tCtrl+Shift+8",          IDM_LOAD_STATE_8
            MENUITEM "存档 9\tCtrl+Shift+9",          IDM_LOAD_STATE_9
        END
        MENUITEM SEPARATOR
        MENUITEM "截图(S)\tF12",                  IDM_SNAPSHOT
    END
    POPUP "工具(&T)"
    BEGIN
        MENUITEM "选项(&O)...",                   IDM_OPTIONS
        MENUITEM SEPARATOR
        MENUITEM "图形查看(&I)...",                 IDM_VIEW_PT
        MENUITEM "卷轴查看(&N),,,",                 IDM_VIEW_NT
        MENUITEM "调色板查看(&P)...",                IDM_VIEW_PAL
        MENUITEM "程序内存查看(&M)...",               IDM_VIEW_MEMORY
        MENUITEM "图案内存查看(&V)...",               IDM_VIEW_VMEMORY
        MENUITEM "精灵内存查看(&S)...",               IDM_VIEW_SPMEMORY
        MENUITEM "寄存器(&R)...",                  IDM_VIEW_REG
        MENUITEM SEPARATOR
        POPUP "日志(&L)"
        BEGIN
            MENUITEM "&1 - TRACE",                  IDM_LOG_TRACE
            MENUITEM "&2 - DEBUG",                  IDM_LOG_DEBUG
            MENUITEM "&3 - INFO",                   IDM_LOG_INFO
            MENUITEM "&4 - WARNING",                IDM_LOG_WARNING
            MENUITEM "&5 - ERROR",                  IDM_LOG_WARNING
            MENUITEM "1&0 - NOTIFY",                IDM_LOG_ERROR
            MENUITEM "&N - NONE",                   IDM_LOG_NONE
            MENUITEM SEPARATOR
            MENUITEM "&C - CPU TRACE",              IDM_CPU_TRACE
        END
        MENUITEM "调试器(&D)...",                  IDM_DEBUGGER
    END
    POPUP "帮助(&H)"
    BEGIN
        MENUITEM "关于(&A) ...",                  IDM_ABOUT
    END
END

IDC_POPUP MENU 
BEGIN
    POPUP "MEMORY"
    BEGIN
        MENUITEM "程序内存",                        ID_MEMORY_CPU
        MENUITEM "图像内存",                        ID_MEMORY_PPU
        MENUITEM "精灵内存",                        ID_MEMORY_SPRIT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDC_INES ACCELERATORS 
BEGIN
    "/",            IDM_ABOUT,              ASCII,  ALT, NOINVERT
    "?",            IDM_ABOUT,              ASCII,  ALT, NOINVERT
    "^U",           IDM_CLOSE,              ASCII,  NOINVERT
    "Q",            IDM_EXIT,               VIRTKEY, ALT, NOINVERT
    VK_SPACE,       IDM_FRAME_STEP,         VIRTKEY, NOINVERT
    VK_F1,          IDM_HARDRESET,          VIRTKEY, CONTROL, NOINVERT
    "O",            IDM_OPEN,               VIRTKEY, CONTROL, NOINVERT
    "P",            IDM_PAUSE,              VIRTKEY, NOINVERT
    VK_F12,         IDM_SNAPSHOT,           VIRTKEY, NOINVERT
    VK_F1,          IDM_SOFTRESET,          VIRTKEY, NOINVERT
    VK_F5,          IDM_ZOOM_X1,            VIRTKEY, NOINVERT
    VK_F6,          IDM_ZOOM_X2,            VIRTKEY, NOINVERT
    VK_F7,          IDM_ZOOM_X3,            VIRTKEY, NOINVERT
    VK_F8,          IDM_ZOOM_X4,            VIRTKEY, NOINVERT
    VK_F9,          IDM_MUTE,               VIRTKEY, NOINVERT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "关于 iNES"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            128,IDC_STATIC,14,14,21,20
    LTEXT           "iNES，1.0 版",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2015",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "确定",IDOK,113,41,50,14,WS_GROUP
END

IDD_NETPLAY DIALOGEX 0, 0, 315, 138
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "网络对战"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "运行为",IDC_STATIC,23,8,262,31
    CONTROL         "服务器",IDC_RAD_SERVER,"Button",BS_AUTORADIOBUTTON | WS_GROUP,31,22,40,10
    CONTROL         "客户机",IDC_RAD_CLIENT,"Button",BS_AUTORADIOBUTTON,150,22,40,10
    LTEXT           "地址",IDC_STATIC,24,44,37,14
    EDITTEXT        IDC_EDT_IP,69,44,112,14,ES_AUTOHSCROLL
    LTEXT           "端口",IDC_STATIC,196,44,21,14
    EDITTEXT        IDC_EDT_PORT,235,44,44,14,ES_AUTOHSCROLL
    LTEXT           "缓冲帧数",IDC_STATIC,21,65,41,14
    COMBOBOX        IDC_CMB_CACHE,67,65,114,89,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "提示信息...",IDC_LAB_INFO,18,95,279,14
    DEFPUSHBUTTON   "开始",IDOK,205,117,50,14
    PUSHBUTTON      "取消",IDCANCEL,258,117,50,14
END


