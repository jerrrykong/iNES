/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_INES                ICON                    "iNES.ico"
IDI_SMALL               ICON                    "small.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

/*
 * 菜单文本只是英文底稿: 启动后由 win32/i18n_ui.c 按 lang/*.ini 整份替换。
 * 因此这里一律不写助记符 '&' 与快捷键 '\tCtrl+O' —— 它们由 i18n_ui.c 的平台表追加,
 * 避免译文把原文里针对英文设计的 '&' 位置吃掉(见 docs/i18n-plan.md §4.2)。
 * 不翻译的条目(日志等级 "1 - TRACE"、数值 "4:3")保留原文。
 *
 * 注意: 各项的排列顺序与 win32/i18n_ui.c 里 s_menu_pops 的位置路径一一对应,
 *       调整本菜单时两边必须同步改。
 */
IDC_INES MENU 
BEGIN
    POPUP "File"
    BEGIN
        MENUITEM "Load ROM...",                 IDM_OPEN
        MENUITEM "Unload ROM",                  IDM_CLOSE
        MENUITEM SEPARATOR
        MENUITEM "Net Play...",                 IDM_NET_PLAY
        MENUITEM "LAN Quick Match...",          IDM_LAN_MATCH
        MENUITEM SEPARATOR
        MENUITEM "Recent Files",                32990, INACTIVE
        MENUITEM SEPARATOR
        MENUITEM "Exit",                        IDM_EXIT
    END
    POPUP "Control"
    BEGIN
        MENUITEM "Hard Reset",                  IDM_HARDRESET
        MENUITEM "Soft Reset",                  IDM_SOFTRESET
        MENUITEM SEPARATOR
        MENUITEM "Pause",                       IDM_PAUSE
        MENUITEM "Frame Step",                  IDM_FRAME_STEP
        MENUITEM SEPARATOR
        MENUITEM "Full Screen",                 IDM_FULL_SCREEN
        POPUP "Zoom"
        BEGIN
            MENUITEM "x 1",                     IDM_ZOOM_X1
            MENUITEM "x 2",                     IDM_ZOOM_X2
            MENUITEM "x 3",                     IDM_ZOOM_X3
            MENUITEM "x 4",                     IDM_ZOOM_X4
        END
        POPUP "Aspect Ratio"
        BEGIN
            MENUITEM "Original",                IDM_SCALE_ORIG
            MENUITEM "4:3",                     IDM_SCALE_4x3
            MENUITEM "16:9",                    IDM_SCALE_16x9
        END
        MENUITEM SEPARATOR
        MENUITEM "Mute",                        IDM_MUTE
        POPUP "Volume"
        BEGIN
            MENUITEM "Volume: 100%",            IDM_VOLUMN_100
            MENUITEM "Volume: 80%",             IDM_VOLUMN_80
            MENUITEM "Volume: 60%",             IDM_VOLUMN_60
            MENUITEM "Volume: 40%",             IDM_VOLUMN_40
            MENUITEM "Volume: 20%",             IDM_VOLUMN_20
            MENUITEM "Volume: 0%",              IDM_VOLUMN_0
        END
        MENUITEM SEPARATOR
        POPUP "Save State"
        BEGIN
            MENUITEM "Save 0",                  IDM_SAVE_STATE_0
            MENUITEM "Save 1",                  IDM_SAVE_STATE_1
            MENUITEM "Save 2",                  IDM_SAVE_STATE_2
            MENUITEM "Save 3",                  IDM_SAVE_STATE_3
            MENUITEM "Save 4",                  IDM_SAVE_STATE_4
            MENUITEM "Save 5",                  IDM_SAVE_STATE_5
            MENUITEM "Save 6",                  IDM_SAVE_STATE_6
            MENUITEM "Save 7",                  IDM_SAVE_STATE_7
            MENUITEM "Save 8",                  IDM_SAVE_STATE_8
            MENUITEM "Save 9",                  IDM_SAVE_STATE_9
        END
        POPUP "Load State"
        BEGIN
            MENUITEM "Load 0",                  IDM_LOAD_STATE_0
            MENUITEM "Load 1",                  IDM_LOAD_STATE_1
            MENUITEM "Load 2",                  IDM_LOAD_STATE_2
            MENUITEM "Load 3",                  IDM_LOAD_STATE_3
            MENUITEM "Load 4",                  IDM_LOAD_STATE_4
            MENUITEM "Load 5",                  IDM_LOAD_STATE_5
            MENUITEM "Load 6",                  IDM_LOAD_STATE_6
            MENUITEM "Load 7",                  IDM_LOAD_STATE_7
            MENUITEM "Load 8",                  IDM_LOAD_STATE_8
            MENUITEM "Load 9",                  IDM_LOAD_STATE_9
        END
        MENUITEM SEPARATOR
        MENUITEM "Snapshot",                    IDM_SNAPSHOT
    END
    POPUP "Tools"
    BEGIN
        MENUITEM "Options...",                  IDM_OPTIONS
        POPUP "Language"                        /* 菜单项由 i18n_ui.c 运行时替换 */
        BEGIN
            MENUITEM "English",                 IDM_LANGUAGE_BASE
        END
        MENUITEM SEPARATOR
        MENUITEM "Pattern Table Viewer...",     IDM_VIEW_PT
        MENUITEM "Name Table Viewer...",        IDM_VIEW_NT
        MENUITEM "Palette Viewer...",           IDM_VIEW_PAL
        MENUITEM "Memory Viewer...",            IDM_VIEW_MEMORY
        MENUITEM "Pattern Memory Viewer...",    IDM_VIEW_VMEMORY
        MENUITEM "Sprite Memory Viewer...",     IDM_VIEW_SPMEMORY
        MENUITEM "Register Viewer...",          IDM_VIEW_REG
        MENUITEM SEPARATOR
        POPUP "Log"
        BEGIN
            MENUITEM "&1 - TRACE",              IDM_LOG_TRACE
            MENUITEM "&2 - DEBUG",              IDM_LOG_DEBUG
            MENUITEM "&3 - INFO",               IDM_LOG_INFO
            MENUITEM "&4 - WARNING",            IDM_LOG_WARNING
            MENUITEM "&5 - ERROR",              IDM_LOG_WARNING
            MENUITEM "1&0 - NOTIFY",            IDM_LOG_ERROR
            MENUITEM "&N - NONE",               IDM_LOG_NONE
            MENUITEM SEPARATOR
            MENUITEM "&C - CPU TRACE",          IDM_CPU_TRACE
        END
        MENUITEM "Debugger...",                 IDM_DEBUGGER
    END
    POPUP "Help"
    BEGIN
        MENUITEM "About...",                    IDM_ABOUT
    END
END

IDC_POPUP MENU 
BEGIN
    POPUP "Memory"
    BEGIN
        MENUITEM "CPU Memory",                  ID_MEMORY_CPU
        MENUITEM "PPU Memory",                  ID_MEMORY_PPU
        MENUITEM "Sprite Memory",               ID_MEMORY_SPRIT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

// 快捷键表(与 mac 侧菜单快捷键对齐): Ctrl+O/Ctrl+U 载入/卸载, Alt+Q 退出,
// Ctrl+F1/F1 上电/复位, P/Space 暂停/单帧, F12 全屏, F5~F8 缩放, F9 静音,
// Ctrl+0~9 存档, Ctrl+Alt+0~9 读档, Ctrl+F10 截图。
// 读档不用 Ctrl+Shift —— Cmd+Shift+3/4/5/6 在 macOS 上是系统截图键, 两侧统一避开。
// 注意: 组合键的字母请避开 A/Z/S/X —— 它们是游戏键, 且游戏输入是轮询式的
// (NesGetKeyState), 不区分修饰键, 否则按下快捷键会同时向游戏注入按键。
IDC_INES ACCELERATORS 
BEGIN
    "/",            IDM_ABOUT,              ASCII,  ALT, NOINVERT
    "?",            IDM_ABOUT,              ASCII,  ALT, NOINVERT
    "^U",           IDM_CLOSE,              ASCII,  NOINVERT
    "Q",            IDM_EXIT,               VIRTKEY, ALT, NOINVERT
    VK_SPACE,       IDM_FRAME_STEP,         VIRTKEY, NOINVERT
    VK_F1,          IDM_HARDRESET,          VIRTKEY, CONTROL, NOINVERT
    "O",            IDM_OPEN,               VIRTKEY, CONTROL, NOINVERT
    "P",            IDM_PAUSE,              VIRTKEY, NOINVERT
    VK_F10,         IDM_SNAPSHOT,           VIRTKEY, CONTROL, NOINVERT
    VK_F1,          IDM_SOFTRESET,          VIRTKEY, NOINVERT
    VK_F5,          IDM_ZOOM_X1,            VIRTKEY, NOINVERT
    VK_F6,          IDM_ZOOM_X2,            VIRTKEY, NOINVERT
    VK_F7,          IDM_ZOOM_X3,            VIRTKEY, NOINVERT
    VK_F8,          IDM_ZOOM_X4,            VIRTKEY, NOINVERT
    VK_F9,          IDM_MUTE,               VIRTKEY, NOINVERT
    VK_F12,         IDM_FULL_SCREEN,        VIRTKEY, NOINVERT
    "0",            IDM_SAVE_STATE_0,       VIRTKEY, CONTROL, NOINVERT
    "1",            IDM_SAVE_STATE_1,       VIRTKEY, CONTROL, NOINVERT
    "2",            IDM_SAVE_STATE_2,       VIRTKEY, CONTROL, NOINVERT
    "3",            IDM_SAVE_STATE_3,       VIRTKEY, CONTROL, NOINVERT
    "4",            IDM_SAVE_STATE_4,       VIRTKEY, CONTROL, NOINVERT
    "5",            IDM_SAVE_STATE_5,       VIRTKEY, CONTROL, NOINVERT
    "6",            IDM_SAVE_STATE_6,       VIRTKEY, CONTROL, NOINVERT
    "7",            IDM_SAVE_STATE_7,       VIRTKEY, CONTROL, NOINVERT
    "8",            IDM_SAVE_STATE_8,       VIRTKEY, CONTROL, NOINVERT
    "9",            IDM_SAVE_STATE_9,       VIRTKEY, CONTROL, NOINVERT
    "0",            IDM_LOAD_STATE_0,       VIRTKEY, CONTROL, ALT, NOINVERT
    "1",            IDM_LOAD_STATE_1,       VIRTKEY, CONTROL, ALT, NOINVERT
    "2",            IDM_LOAD_STATE_2,       VIRTKEY, CONTROL, ALT, NOINVERT
    "3",            IDM_LOAD_STATE_3,       VIRTKEY, CONTROL, ALT, NOINVERT
    "4",            IDM_LOAD_STATE_4,       VIRTKEY, CONTROL, ALT, NOINVERT
    "5",            IDM_LOAD_STATE_5,       VIRTKEY, CONTROL, ALT, NOINVERT
    "6",            IDM_LOAD_STATE_6,       VIRTKEY, CONTROL, ALT, NOINVERT
    "7",            IDM_LOAD_STATE_7,       VIRTKEY, CONTROL, ALT, NOINVERT
    "8",            IDM_LOAD_STATE_8,       VIRTKEY, CONTROL, ALT, NOINVERT
    "9",            IDM_LOAD_STATE_9,       VIRTKEY, CONTROL, ALT, NOINVERT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About iNES"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDI_INES,IDC_STATIC,14,14,21,20
    LTEXT           "iNES, version 1.0",IDC_ABOUT_LAB_VERSION,42,14,114,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2015",IDC_ABOUT_LAB_COPYRIGHT,42,26,114,8
    DEFPUSHBUTTON   "OK",IDOK,113,41,50,14,WS_GROUP
END

IDD_NETPLAY DIALOGEX 0, 0, 315, 138
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Net Play"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Run as",IDC_NETPLAY_GRP_RUN_AS,23,8,262,31
    CONTROL         "Server",IDC_RAD_SERVER,"Button",BS_AUTORADIOBUTTON | WS_GROUP,31,22,40,10
    CONTROL         "Client",IDC_RAD_CLIENT,"Button",BS_AUTORADIOBUTTON,150,22,40,10
    LTEXT           "Address",IDC_NETPLAY_LAB_ADDRESS,24,44,37,14
    EDITTEXT        IDC_EDT_IP,69,44,112,14,ES_AUTOHSCROLL
    LTEXT           "Port",IDC_NETPLAY_LAB_PORT,196,44,21,14
    EDITTEXT        IDC_EDT_PORT,235,44,44,14,ES_AUTOHSCROLL
    LTEXT           "Cache frames",IDC_NETPLAY_LAB_CACHE,21,65,41,14
    // 缓冲帧数不再可选: 唯一来源是 config.ini 的 [netplay] cache_num(与 mac 端一致),
    // 这里只作只读显示(原来是 COMBOBOX, 改了也不生效, 属误导)
    LTEXT           "",IDC_CMB_CACHE,67,66,240,10
    LTEXT           "",IDC_LAB_INFO,18,95,279,14
    DEFPUSHBUTTON   "Start",IDOK,205,117,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,258,117,50,14
END

// 载入 NES 文件管理器: 上(文件夹选择) / 中(可拉伸文件列表) / 下(加载、取消)
IDD_OPENROM DIALOGEX 0, 0, 440, 300
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_CLIPCHILDREN
CAPTION "Load NES File"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "Folder:",IDC_OPENROM_LAB_DIR,7,12,40,10
    EDITTEXT        IDC_OPENROM_EDT_DIR,52,8,350,16,ES_AUTOHSCROLL
    CONTROL         "",IDC_OPENROM_BTN_DIR,"Button",BS_PUSHBUTTON | BS_ICON | WS_TABSTOP,408,8,26,16
    CONTROL         "",IDC_OPENROM_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,7,30,427,240
    LTEXT           "",IDC_OPENROM_LAB_COUNT,7,278,240,12
    DEFPUSHBUTTON   "Load",IDOK,300,275,60,18
    PUSHBUTTON      "Cancel",IDCANCEL,368,275,60,18
END

// 局域网快速对战: 上(昵称/本机 ROM/说明) / 中(房间列表) / 下(缓冲帧数、提示、加入、关闭)
IDD_LANMATCH DIALOGEX 0, 0, 440, 300
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "LAN Quick Match"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "Nickname:",IDC_LANMATCH_LAB_NICK,7,12,30,10
    EDITTEXT        IDC_LANMATCH_EDT_NICK,40,8,150,16,ES_AUTOHSCROLL
    LTEXT           "",IDC_LANMATCH_LAB_ROM,200,12,233,10
    LTEXT           "",IDC_LANMATCH_LAB_HINT,7,30,426,24
    CONTROL         "",IDC_LANMATCH_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,7,56,427,182
    LTEXT           "Cache frames",IDC_LANMATCH_LAB_CACHE,7,246,40,10
    // 同"联网对战"对话框: 只读显示, 值来自 config.ini 的 [netplay] cache_num
    LTEXT           "",IDC_LANMATCH_CMB_CACHE,52,246,300,10
    LTEXT           "",IDC_LANMATCH_LAB_INFO,7,260,426,10
    DEFPUSHBUTTON   "Join",IDOK,300,275,60,18
    PUSHBUTTON      "Close",IDCANCEL,368,275,60,18
END


